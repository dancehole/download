# ============================================
# 活动照片流系统 - 环境配置示例
# ============================================
# 复制为 .env 后修改
# ============================================

# ---------- 部署路径前缀 ----------
# 子目录部署时设置，如 /download → 管理页 /download/admin，分享页 /download/share/{token}
# 留空则部署在根路径
APP_PREFIX=/download

# ---------- 数据库配置 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=photo_gallery

# ---------- JWT 配置 ----------
# 请修改为一个长随机字符串，用于签名登录 token
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=72

# ---------- 图片处理 ----------
PREVIEW_MAX_SIZE=640
PREVIEW_QUALITY=85
IMAGE_PROCESS_CONCURRENCY=2

# ---------- 上传限制 ----------
MAX_UPLOAD_SIZE_MB=50
# 共享文件（下载中心合并）单文件上限，默认 500MB
FILE_MAX_UPLOAD_SIZE_MB=500

# ---------- 默认管理员账号 ----------
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
